# =============================================================================
# Telegram Manager - Environment variables
# =============================================================================
# 1. Copy this file to `.env`        (cp .env.example .env)
# 2. Fill in your API credentials from https://my.telegram.org/apps
#    (OPTIONAL - only needed if you plan to use the 'default' device preset)
# 3. NEVER commit .env to git (already in .gitignore)
# =============================================================================

# ---- Your own Telegram API (optional) --------------------------------------
# Required only for the `default` device preset. If you'll always use official
# device presets (iphone_*, samsung_*, desktop_*, etc.), you can leave these
# blank - the presets bundle their own (leaked) credentials.
#
# Get yours at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---- Optional --------------------------------------------------------------
# Default session name for quick testing
# DEFAULT_SESSION_NAME=main

# Proxy (SOCKS5). Leave commented unless needed.
# PROXY_TYPE=socks5
# PROXY_HOST=127.0.0.1
# PROXY_PORT=1080
# PROXY_USER=
# PROXY_PASS=

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- Bot mode (for remote management via Telegram bot) ---------------------
# Create a bot via @BotFather, paste the token here
# BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ---- Supabase (database storage) ------------------------------------------
# Get these from your Supabase project Settings > API
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_KEY=eyJhbGciOiJIUzI1NiIs...

# ---- Broadcast watermark ---------------------------------------------------
# Text appended below every broadcast message. Leave empty for none.
# WATERMARK=Powered by TM

# ---- Owners / VIP -----------------------------------------------------------
# Telegram user IDs allowed to run owner-only commands such as /gift.
# Separate multiple owners with comma or spaces.
# OWNER_IDS=123456789,987654321

# ---- Logging ---------------------------------------------------------------
# Chat ID or @username where broadcast logs are sent (blocked, flood, errors)
# If not set, logs go to the user's own chat
# LOG_CHAT_ID=123456789
# LOG_CHAT_ID=@mylogchannel
