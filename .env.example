# =============================================================================
# Telegram Manager - Environment variables
# =============================================================================
# 1. Copy this file to `.env`        (cp .env.example .env)
# 2. Fill in your API credentials from https://my.telegram.org/apps
#    (OPTIONAL - only needed if you plan to use the 'default' device preset)
# 3. NEVER commit .env to git (already in .gitignore)
# =============================================================================

# ---- Telegram API credentials ------------------------------------------------
# Primary credential. Required for login and bot account sessions.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Extra credentials for large account pools. Separate entries with semicolon.
# Format: api_id:api_hash;api_id:api_hash
# TELEGRAM_API_CREDENTIALS=111111:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa;222222:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

# Soft distribution limit used when assigning new accounts to API credentials.
# Example: 250 means each api_id/api_hash is preferred for up to 250 accounts.
# TELEGRAM_API_ACCOUNT_LIMIT=250

# ---- Broadcast concurrency ---------------------------------------------------
# Max active broadcasting accounts for one admin at a time.
# BROADCAST_PER_ADMIN_CONCURRENCY=15
# Max active broadcasting accounts across this bot process.
# BROADCAST_GLOBAL_CONCURRENCY=150

# ---- Owner runtime error alerts ---------------------------------------------
# Cooldown for duplicate runtime error alerts sent to OWNER_IDS / OWNER_ID.
# OWNER_ERROR_ALERT_COOLDOWN_SECONDS=600

# ---- Proxy pool --------------------------------------------------------------
# Preferred for large proxy pools. One proxy URL per line; blank lines and # comments are ignored.
# TELEGRAM_PROXIES_FILE=proxies.txt

# Inline fallback format. Separate proxy URLs with semicolon.
# TELEGRAM_PROXIES=socks5://user:pass@host1:1080;socks5://user:pass@host2:1080
# Note: connected_ip runtime metadata for bot accounts is derived from the assigned proxy host when proxies are used.

# Legacy single proxy format. Leave commented unless needed.
# PROXY_TYPE=socks5
# PROXY_HOST=127.0.0.1
# PROXY_PORT=1080
# PROXY_USER=
# PROXY_PASS=

# ---- Optional --------------------------------------------------------------
# Default session name for quick testing
# DEFAULT_SESSION_NAME=main

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- Bot mode (for remote management via Telegram bot) ---------------------
# Create a bot via @BotFather, paste the token here
# BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ---- Supabase (database storage) ------------------------------------------
# Get these from your Supabase project Settings > API
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_KEY=eyJhbGciOiJIUzI1NiIs...

# ---- Broadcast watermark ---------------------------------------------------
# Text appended below every broadcast message. Leave empty for none.
# WATERMARK=Powered by TM

# ---- Owners / VIP -----------------------------------------------------------
# Telegram user IDs allowed to run owner-only commands such as /gift.
# Separate multiple owners with comma or spaces.
# OWNER_IDS=5632761062,5717900563

# ---- Logging ---------------------------------------------------------------
# Bot/group/user ID or @username where each broadcasting account sends logs.
# If not set, logs only go to the user's own chat via bot.
# LOG_CHAT_ID=123456789
# LOG_CHAT_ID=@mylogchannel

# ---- Auto Health Check -----------------------------------------------------
# Interval in seconds between automatic account health checks (default: 43200 = 12h)
# AUTO_HEALTH_CHECK_INTERVAL_SECONDS=43200

# ---- Auto Reply ------------------------------------------------------------
# Maximum number of persistent Telethon clients used for auto-reply.
# Keep this small to avoid resource exhaustion.
# AUTO_REPLY_MAX_CLIENTS=20

# Interval in seconds between auto-reply client reconciliation loops.
# AUTO_REPLY_RECONCILE_INTERVAL=90
